---
const links = [
  { href: '/software', label: 'Software' },
  { href: '/blog', label: 'Blog' },
];

const { pathname } = Astro.url;
const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <nav class="site-header__inner" aria-label="Site">
    <a class="nav-link" href="/" aria-current={pathname === '/' ? 'page' : undefined}>
      Home
    </a>
    <div class="nav">
      {links.map((link) => (
        <a
          class="nav-link"
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
