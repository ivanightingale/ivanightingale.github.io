---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TagPill from './TagPill.astro';
import { getPostDates, formatPostDate } from '../lib/post-dates';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const href = `/blog/${post.id}/`;
const { created, updated, showUpdated } = await getPostDates(post);
const formattedCreated = formatPostDate(created, 'short');
const formattedUpdated = formatPostDate(updated, 'short');

const wrapperClass = data.cover ? 'post-item' : 'post-item post-item--textonly';

const coverWidths = [200, 400];
const coverSizes = '(max-width: 720px) 100vw, 200px';
---

<article class={wrapperClass}>
  <div class="post-item__body">
    <div class="post-meta">
      <time class="post-date" datetime={created.toISOString()}>{formattedCreated}</time>
      {showUpdated && (
        <time class="post-date post-date--updated" datetime={updated.toISOString()}>
          Updated {formattedUpdated}
        </time>
      )}
    </div>
    <h2 class="post-item__title">
      <a href={href}>{data.title}</a>
    </h2>
    <p class="post-excerpt">{data.description}</p>
    {data.tags.length > 0 && (
      <div class="tag-row">
        {data.tags.map((tag) => (
          <TagPill tag={tag} />
        ))}
      </div>
    )}
  </div>
  {data.cover && (
    /* Decorative in a list: the title link already names the destination. */
    <a class="post-item__cover" href={href} tabindex="-1" aria-hidden="true">
      <Image src={data.cover.src} alt="" widths={coverWidths} sizes={coverSizes} />
    </a>
  )}
</article>
