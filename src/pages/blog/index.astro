---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date - a.data.date);
const [newest, ...rest] = posts;
---

<BaseLayout title="Blog" description="Blog posts by Guancheng Qiu.">
  <div class="spread">
    <div class="spread__rail">
      <h1 class="spread__title">Blog</h1>
      <p class="spread__meta"><a href="/blog/tags/">Browse by tag</a></p>
    </div>
    <div class="spread__body">
      {posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <>
          <PostCard post={newest} lead />
          {rest.length > 0 && (
            <ul class="posts">
              {rest.map((post) => (
                <li><PostCard post={post} /></li>
              ))}
            </ul>
          )}
        </>
      )}
    </div>
  </div>
</BaseLayout>
