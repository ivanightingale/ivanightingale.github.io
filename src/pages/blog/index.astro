---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getPostDates } from '../../lib/post-dates';

const posts = await getCollection('blog');
const ordered = (
  await Promise.all(
    posts.map(async (post) => ({ post, created: (await getPostDates(post)).created }))
  )
).sort((a, b) => b.created.getTime() - a.created.getTime());
---

<BaseLayout title="Blog" description="Blog posts by Guancheng Qiu.">
  <div class="spread">
    <div class="spread__rail">
      <h1 class="spread__title">Blog</h1>
      <p class="spread__meta">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        <br />
        <a href="/blog/tags/">Browse by tag</a>
      </p>
    </div>
    <div class="spread__body">
      {posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="posts">
          {ordered.map((entry) => (
            <li><PostCard post={entry.post} /></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
