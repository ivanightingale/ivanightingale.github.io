---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection, render } from 'astro:content';
import { getGitDates } from '../../lib/git-dates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { created, updated } = await getGitDates(post.filePath);
const createdDate = created ?? post.data.date;
const updatedDate = updated ?? post.data.date;

const formatter = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const formattedCreated = formatter.format(createdDate);
const formattedUpdated = formatter.format(updatedDate);

const dayKey = (d: Date) =>
  `${d.getUTCFullYear()}-${d.getUTCMonth()}-${d.getUTCDate()}`;
const showUpdated = dayKey(createdDate) !== dayKey(updatedDate);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="spread">
    <div class="spread__rail">
      <time class="post-date" datetime={createdDate.toISOString()}>{formattedCreated}</time>
      {showUpdated && (
        <time class="post-date post-date--updated" datetime={updatedDate.toISOString()}>
          Updated {formattedUpdated}
        </time>
      )}
      {post.data.tags.length > 0 && (
        <div class="spread__meta">
          <div class="tag-row">
            {post.data.tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        </div>
      )}
    </div>
    <div class="spread__body">
      <h1 class="article__title">{post.data.title}</h1>
      {post.data.cover && (
        <Image
          class="article__cover"
          src={post.data.cover.src}
          alt={post.data.cover.alt}
          widths={[440, 880]}
          sizes="800px"
        />
      )}
      <div class="article__body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
