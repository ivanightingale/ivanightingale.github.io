---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(post.data.date);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="spread">
    <div class="spread__rail">
      <time class="post-date" datetime={post.data.date.toISOString()}>{formattedDate}</time>
      {post.data.tags.length > 0 && (
        <div class="spread__meta">
          <div class="tag-row">
            {post.data.tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        </div>
      )}
    </div>
    <div class="spread__body">
      <h1 class="article__title">{post.data.title}</h1>
      {post.data.cover && (
        <Image
          class="article__cover"
          src={post.data.cover.src}
          alt={post.data.cover.alt}
          widths={[440, 880]}
          sizes="800px"
        />
      )}
      <div class="article__body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
