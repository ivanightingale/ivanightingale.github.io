---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../../lib/slugify';
import { getPostDates } from '../../../lib/post-dates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const matching = (await getCollection('blog')).filter((post) =>
  post.data.tags.some((t) => slugify(t) === tag)
);
const posts = (
  await Promise.all(
    matching.map(async (post) => ({ post, created: (await getPostDates(post)).created }))
  )
)
  .sort((a, b) => b.created.getTime() - a.created.getTime())
  .map((entry) => entry.post);
---

<BaseLayout title={`Posts tagged "${tag}"`} description={`Blog posts tagged ${tag}.`}>
  <div class="spread">
    <div class="spread__rail">
      <h1 class="spread__title">{tag}</h1>
      <p class="spread__meta">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        <br />
        <a href="/blog/tags/">All tags</a>
      </p>
    </div>
    <div class="spread__body">
      {posts.length === 0 ? (
        <p class="empty">No posts with this tag.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li><PostCard post={post} /></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
