---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../../lib/slugify';

const posts = await getCollection('blog');
const tagsBySlug = new Map<string, { tag: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = slugify(tag);
    const entry = tagsBySlug.get(slug);
    if (entry) entry.count += 1;
    else tagsBySlug.set(slug, { tag, count: 1 });
  }
}
const tags = [...tagsBySlug.entries()].sort((a, b) => a[1].tag.localeCompare(b[1].tag));
---

<BaseLayout title="Blog tags" description="All blog post tags.">
  <div class="spread">
    <div class="spread__rail">
      <h1 class="spread__title">Tags</h1>
      <p class="spread__meta"><a href="/blog/">All posts</a></p>
    </div>
    <div class="spread__body">
      {tags.length === 0 ? (
        <p class="empty">No tags yet.</p>
      ) : (
        <ul class="tag-index">
          {tags.map(([slug, { tag, count }]) => (
            <li>
              <a href={`/blog/tags/${slug}/`}>
                <span>{tag}</span>
                <span class="tag-index__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
