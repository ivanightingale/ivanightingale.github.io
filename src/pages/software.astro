---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('software');
---

<BaseLayout title="Software" description="Software projects by Guancheng Qiu.">
  <div class="spread">
    <div class="spread__rail">
      <h1 class="spread__title">Software</h1>
    </div>
    <div class="spread__body">
      {projects.length === 0 ? (
        <p class="empty">No projects listed yet.</p>
      ) : (
        <ul class="projects">
          {projects.map((project) => (
            <li class="project">
              <h2 class="project__name">{project.data.name}</h2>
              <p class="project__desc">{project.data.description}</p>
              {project.data.tags.length > 0 && (
                <div class="project__tags">
                  {project.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              {project.data.github && (
                <a class="project__link" href={project.data.github}>GitHub</a>
              )}
              {project.data.image && (
                <Image
                  class="project__shot"
                  src={project.data.image}
                  alt={`${project.data.name} screenshot`}
                  widths={[440, 880]}
                  sizes="800px"
                />
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
